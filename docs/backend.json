{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user account and their wallet balances.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "password": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "balance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "mobile", "status"]
    },
    "Game": {
      "title": "Game",
      "description": "A matka game market.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "openTime": { "type": "string" },
        "closeTime": { "type": "string" },
        "active": { "type": "boolean" },
        "result": { "type": "string" }
      },
      "required": ["id", "name", "openTime", "closeTime"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile data"
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/Game" },
      "description": "Main market games"
    }
  }
}