{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user account and their wallet balances.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "password": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "balance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "depositBonusEnabled": { "type": "boolean" },
        "depositBonusPercentage": { "type": "number" },
        "totalBonusGiven": { "type": "number" },
        "hasDeposited": { "type": "boolean" },
        "referredBy": { "type": "string" }
      },
      "required": ["id", "name", "mobile", "status"]
    },
    "Game": {
      "title": "Game",
      "description": "A matka market game.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "openTime": { "type": "string" },
        "closeTime": { "type": "string" },
        "active": { "type": "boolean" },
        "result": { "type": "string" },
        "openResult": { "type": "string" },
        "closeResult": { "type": "string" },
        "status": { "type": "string" },
        "activeDays": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "openTime", "closeTime"]
    },
    "StarlineGame": {
      "title": "StarlineGame",
      "description": "Hourly starline market slot.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "time": { "type": "string" },
        "panna": { "type": "string" },
        "digit": { "type": "string" },
        "status": { "type": "string", "enum": ["running", "closed"] },
        "active": { "type": "boolean" }
      }
    },
    "JackpotGame": {
      "title": "JackpotGame",
      "description": "Jackpot market slot.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "time": { "type": "string" },
        "result": { "type": "string" },
        "status": { "type": "string", "enum": ["running", "closed"] },
        "active": { "type": "boolean" }
      }
    },
    "Bid": {
      "title": "Bid",
      "description": "A bet placed by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "gameId": { "type": "string" },
        "gameName": { "type": "string" },
        "betType": { "type": "string" },
        "session": { "type": "string" },
        "numbers": { "type": "array", "items": { "type": "string" } },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["running", "won", "lost", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "betSource": { "type": "string", "enum": ["real", "bonus"] },
        "winningAmount": { "type": "number" },
        "isStarline": { "type": "boolean" },
        "isJackpot": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile data"
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/Game" },
      "description": "Main market games"
    },
    "/starlineGames/{gameId}": {
      "schema": { "$ref": "#/entities/StarlineGame" },
      "description": "Starline market games"
    },
    "/jackpotGames/{gameId}": {
      "schema": { "$ref": "#/entities/JackpotGame" },
      "description": "Jackpot market games"
    },
    "/bids/{bidId}": {
      "schema": { "$ref": "#/entities/Bid" },
      "description": "User betting records"
    },
    "/transactions/{transactionId}": {
      "schema": { "type": "object" },
      "description": "Ledger entries"
    },
    "/settings/app-settings": {
      "schema": { "type": "object" },
      "description": "Global application configuration"
    },
    "/settings/gameRates": {
      "schema": { "type": "object" },
      "description": "Winning rate configuration"
    },
    "/notifications/{notifId}": {
      "schema": { "type": "object" },
      "description": "Broadcast notifications"
    },
    "/panelCharts/{gameId}": {
      "schema": { "type": "object" },
      "description": "Panel calendar charts"
    },
    "/jodiCharts/{gameId}": {
      "schema": { "type": "object" },
      "description": "Jodi history charts"
    },
    "/deposits/{depositId}": {
      "schema": { "type": "object" },
      "description": "Deposit requests"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "type": "object" },
      "description": "Withdrawal requests"
    }
  }
}
