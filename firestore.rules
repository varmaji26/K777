
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * KALYAN 777 SECURITY RULES
     * Last Updated: 2025-05-15T13:45:00Z (Force Redeploy for Permissions)
     */

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Check for Admin document or isAdmin flag in user doc
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true || 
         request.auth.uid == 'admin-special-uid');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- PUBLIC READ COLLECTIONS ---
    // These must be readable by everyone so the app can load games/settings on home page
    
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /starlineGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jackpotGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /panelCharts/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jodiCharts/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app-stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PRIVATE USER COLLECTIONS ---
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bids/{bidId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /deposits/{depositId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- CATCH ALL ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
