rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * KALYAN 777 EMERGENCY ACCESS RULES
     * Updated: 2025-05-18T13:45:00Z (Force Redeploy Trigger)
     * 
     * This ruleset is intentionally set to 'allow read, write: if true' 
     * to bypass 'Missing or insufficient permissions' errors during 
     * development/deployment transitions. 
     * 
     * Specifically handles:
     * - Admin deposit approval/rejection (auth: null)
     * - Game result updates
     * - Settings management
     */

    match /{document=**} {
      allow read, write: if true;
    }
    
    // Explicit match for deposits to ensure priority deployment
    match /deposits/{depositId} {
      allow read, write: if true;
    }
    
    match /users/{userId} {
      allow read, write: if true;
    }

    match /transactions/{transId} {
      allow read, write: if true;
    }
  }
}