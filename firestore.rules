
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Checking admin status (Marker collection or field)
    function isAdmin() {
      return exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) || 
             (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    /**
     * PUBLIC ACCESS RULES
     * These collections must be readable by anyone (including unauthenticated users)
     * so that the game list and settings can load immediately.
     */
    
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /starlineGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /jackpotGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /panelCharts/{chartId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jodiCharts/{chartId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * PRIVATE USER DATA
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    match /users {
      allow list: if isAdmin();
    }

    match /bids/{bidId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /deposits/{depositId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /app-stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /adminRoles/{adminId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }

    // Global fallback for any other collection
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
