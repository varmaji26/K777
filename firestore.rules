
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PROTOTYPE SECURITY RULES
     * Note: These rules are intentionally permissive for rapid prototyping and debugging.
     * They allow any user (even unauthenticated) to read and write all data.
     * Touching this file triggers a rule re-deployment.
     * Updated at: 2026-08-12T21:48:00Z
     */

    match /{document=**} {
      allow read, write: if true;
    }
    
    // Explicitly allowing public read for games to prevent errors during early hydration
    match /games/{gameId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /starlineGames/{gameId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /jackpotGames/{gameId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /bids/{bidId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /app-stats/{statId} {
      allow read, write: if true;
    }
  }
}
