rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * KALYAN 777 GLOBAL ACCESSIBLE RULES
     * Updated: 2025-05-18T10:45:00Z (Force Redeploy Cache Buster)
     * Note: Fully open for prototype stability to prevent all 'Permission Denied' errors.
     */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
