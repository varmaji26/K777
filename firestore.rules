
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PROTOTYPE SECURITY RULES
     * Note: These rules are intentionally permissive for rapid prototyping and debugging.
     * They allow any user (even unauthenticated) to read and write all data.
     */

    match /{document=**} {
      allow read, write: if true;
    }
    
    // Explicitly mentioning common collections to ensure deployment triggers
    match /games/{gameId} {
      allow read, write: if true;
    }
    
    match /starlineGames/{gameId} {
      allow read, write: if true;
    }
    
    match /jackpotGames/{gameId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /bids/{bidId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
