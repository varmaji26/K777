
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * KALYAN 777 SECURITY RULES
     * Updated at: 2025-05-15T12:05:00Z (Force redeploy to fix permission errors)
     * 
     * Core Philosophy:
     * - Public data (Games, Settings, Charts, Notifications) is readable by everyone.
     * - User private data (Profiles, Bids, Transactions) is protected by ownership.
     * - Admin access is controlled via 'isAdmin' flag in the user document.
     */

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // For prototyping, we check the user document directly
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true || 
         request.auth.uid == 'admin-special-uid');
    }

    // --- PUBLIC READ COLLECTIONS ---
    // These collections must be readable by any visitor to see results and schedules
    
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /starlineGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jackpotGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /panelCharts/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jodiCharts/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app-stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PRIVATE USER COLLECTIONS ---
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow creation during signup
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bids/{bidId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      // On create, ensure user provides their own ID
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /deposits/{depositId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- CATCH ALL ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
