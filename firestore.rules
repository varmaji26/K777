rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * KALYAN 777 GLOBAL ACCESSIBLE RULES
     * Updated: 2025-05-16T10:00:00Z
     * Note: Fully open for prototype stability to prevent 'Permission Denied' errors.
     */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
