
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MATKA APP SECURITY RULES
     * Updated at: 2025-05-15T10:00:00Z (Fixing all public read permissions)
     */

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // High performance admin check (requires user doc or custom claims)
      // For prototyping, we allow admin access if 'isAdmin' field is true on the user document
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true || 
         request.auth.uid == 'admin-special-uid');
    }

    // --- PUBLIC READ COLLECTIONS ---
    // Anyone (even guest users) should be able to see games, results, settings and charts
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /starlineGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jackpotGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /panelCharts/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jodiCharts/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app-stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PRIVATE USER COLLECTIONS ---
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow creation during signup
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bids/{bidId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      // On create, ensure user provides their own ID
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn(); // Logged via server or non-blocking client logic
      allow update, delete: if isAdmin();
    }

    match /deposits/{depositId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- CATCH ALL ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
