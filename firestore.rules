
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Checking admin status
    function isAdmin() {
      return exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) || 
             (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Allow wide access for prototype/setup phase to avoid permission errors
    match /{document=**} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true; 
    }
    
    match /users {
      allow list: if true; 
    }

    match /games/{gameId} {
      allow read, write: if true;
    }

    match /starlineGames/{gameId} {
      allow read, write: if true;
    }

    match /jackpotGames/{gameId} {
      allow read, write: if true;
    }

    match /bids/{bidId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
    
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /panelCharts/{chartId} {
      allow read, write: if true;
    }
    
    match /jodiCharts/{chartId} {
      allow read, write: if true;
    }

    match /app-stats/{statId} {
      allow read, write: if true;
    }
    
    match /adminRoles/{adminId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }
  }
}
